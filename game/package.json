{
  "name": "agroecosystem-sim-game",
  "private": true,
  "version": "0.0.1",
  "description": "Florida Agroecosystem Farm Simulator - browser game",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",

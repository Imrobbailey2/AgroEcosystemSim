    "lint": "eslint .",
    "test": "vitest run",
    "test:a11y": "playwright test"
  },
  "dependencies": {
    "preact": "^10.26.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.52.0",
    "@preact/preset-vite": "^2.10.1",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^22.15.0",
    "eslint": "^9.25.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.2"
  }
}
